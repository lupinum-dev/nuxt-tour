{
  "name": "@lupinum/nuxt-tour",
  "version": "0.2.1",
  "description": "Build accessible, route-aware product tours with a Vue-native API and Nuxt-first developer experience.",
  "type": "module",
  "license": "MIT",
  "author": "Lupinum OG <info@lupinum.com> (https://lupinum.com)",
  "homepage": "https://nuxt-tour.lupinum.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lupinum-dev/nuxt-tour.git"
  },
  "bugs": {
    "url": "https://github.com/lupinum-dev/nuxt-tour/issues"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./vue": {
      "types": "./dist/runtime/vue/index.d.ts",
      "import": "./dist/runtime/vue/index.js"
    },
    "./registry": {
      "types": "./dist/runtime/registry.d.ts",
      "import": "./dist/runtime/registry.js"
    },
    "./agent-docs": "./dist/agent/AGENTS.md",
    "./style.css": "./dist/runtime/style.css",
    "./structure.css": "./dist/runtime/structure.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "vue": [
        "./dist/runtime/vue/index.d.ts"
      ],
      "registry": [
        "./dist/runtime/registry.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "pnpm dev:prepare && nuxt dev playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "build": "nuxt-module-build prepare && nuxt-module-build build && pnpm docs:build && node scripts/check-demo-markdown.mjs && node scripts/agent-docs.mjs && publint",
    "lint": "eslint . && node scripts/sync-consumer-onboarding.mjs && node scripts/check-docs-theme.mjs && node scripts/lint-changesets.mjs",
    "format": "eslint . --fix && node scripts/sync-consumer-onboarding.mjs --write",
    "typecheck": "pnpm dev:prepare && vue-tsc --noEmit && pnpm --dir playground typecheck && pnpm --dir docs typecheck",
    "test": "nuxt-module-build prepare && nuxt prepare test/fixtures/basic && nuxt prepare test/fixtures/layers/project && vitest run",
    "test:types": "nuxt typecheck test/fixtures/basic && nuxt typecheck test/fixtures/layers/project",
    "test:bundle": "node scripts/measure-bundle.mjs --check",
    "test:browser": "nuxt-module-build prepare && playwright test",
    "test:packed": "node scripts/verify-packed-consumer.mjs && node scripts/verify-packed-consumer.mjs --framework vue",
    "docs:dev": "pnpm --dir docs dev",
    "docs:build": "nuxt-module-build prepare && pnpm --dir docs build",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:types && pnpm test:bundle && pnpm build && pnpm test:browser --project=chromium && pnpm test:packed && node scripts/audit-deps.mjs",
    "changeset": "changeset"
  },
  "dependencies": {
    "@floating-ui/vue": "^2.0.1",
    "@nuxt/kit": "^4.5.2",
    "focus-trap": "^8.2.2",
    "pathe": "^2.0.3"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.1.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.9.0",
    "happy-dom": "20.11.12",
    "nuxt": "^4.5.2",
    "pkg-pr-new": "0.0.87",
    "publint": "0.3.24",
    "typescript": "~5.9.3",
    "vite": "8.2.2",
    "vitest": "^4.1.11",
    "vue": "3.5.42",
    "vue-tsc": "^3.3.11",
    "yaml": "2.9.0"
  }
}
